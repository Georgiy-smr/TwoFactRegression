<Window x:Class="TwoFactRegressCalc.DatasetReviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" mc:Ignorable="d"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TwoFactRegressCalc.ViewModels"
        d:DataContext="{d:DesignInstance Type={x:Type vm:DatasetReviewViewModel} }"
        Title="Проверка точек"
        Height="400" Width="780"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0"
                    Text="{Binding Message}"
                    Margin="0 0 0 10"
                    FontWeight="SemiBold"
                    TextWrapping="Wrap"/>

        <ListView Grid.Row="1" ItemsSource="{Binding Rows}">
            <ListView.View>
                <GridView>
                    <GridViewColumn Header="Температура, °C" Width="110" DisplayMemberBinding="{Binding NominalTemperature, StringFormat={}{0:0.#}}"/>
                    <GridViewColumn Header="Строка Excel" Width="100" DisplayMemberBinding="{Binding ExcelRow}"/>
                    <GridViewColumn Header="Давление" Width="100" DisplayMemberBinding="{Binding Pressure}"/>
                    <GridViewColumn Header="Результат" Width="300" DisplayMemberBinding="{Binding Result}"/>
                    <GridViewColumn Header="Отклонение кода" Width="120" DisplayMemberBinding="{Binding CodeError, StringFormat={}{0:0.##}}"/>
                </GridView>
            </ListView.View>
        </ListView>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0 10 0 0">
            <Button Content="Продолжить расчёт"
                    MinWidth="80"
                    Padding="10 4"
                    Margin="0 0 8 0"
                    Command="{Binding ContinueCommand}"/>
            <Button Content="Отмена"
                    MinWidth="80"
                    Padding="10 4"
                    IsCancel="True"
                    IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
